{
  "name": "claudekishmish",
  "version": "0.2.0",
  "description": "Keep a Claude Code usage window always running, and continue interrupted work in the terminal it stopped in.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ckm": "dist/cli/index.js",
    "claudekishmish": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "scripts/verify-against-real-history.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsspriceai/claudekishmish.git"
  },
  "homepage": "https://github.com/gsspriceai/claudekishmish#readme",
  "bugs": {
    "url": "https://github.com/gsspriceai/claudekishmish/issues"
  },
  "author": "Gantavya Singh Shekhawat",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "postinstall": "node scripts/postinstall.mjs",
    "verify:history": "node scripts/verify-against-real-history.mjs",
    "mutation-check": "npm run build && node scripts/mutation-check.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && vitest run"
  },
  "keywords": [
    "claude",
    "claude-code",
    "usage-limit",
    "auto-resume",
    "cli",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
