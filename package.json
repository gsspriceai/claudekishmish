{
  "name": "claudekishmish",
  "version": "0.1.0",
  "description": "Keep a Claude Code usage window always running, and continue interrupted work in the terminal it stopped in.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ckm": "dist/cli/index.js",
    "claudekishmish": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "usage-limit",
    "auto-resume",
    "cli",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
